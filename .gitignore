# scratch / regenerable data — never commit
*.dat
*.log
*.pfw
*.tar
*.qcow2
__pycache__/
*.pyc

# local tooling / editor / agent config
.claude/
.wakatime-project

# stray empty capture
results/**/*_gdsstats.txt

# python envs (the real env is /opt/gds-venv on the image)
venv/
.venv/

# compiled tracer artifact (build from tools/gds_trace_preload.c)
*.so

# stray PDFs dropped at the repo root (e.g. papers shared by others) -- never publish
/*.pdf

# the paper lives in its own repo (codeberg: izzet/paper-gdsight)
paper/

# agent orientation, not artifact material
CLAUDE.md
